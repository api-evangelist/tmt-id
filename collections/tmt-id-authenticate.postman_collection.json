  "item": [
    {
      "id": "df375542-50a4-4d31-bff6-cd5d6a52cc66",
      "name": "About TMT",
      "description": {
        "content": "\nTMT ID is a leading provider of data, intelligence and analytics, helping customers find extra value from the information they hold. Our team of technology and telecommunications specialists has a proven track record empowering companies, brands and agencies around the world to better understand their businesses and their customers. TMT ID has a suite of technology and telecommunications data available, for further information, please visit [www.tmtid.com](https://www.tmtid.com) or email info@tmtid.com.",
        "type": "text/plain"
      },
      "item": [],
      "event": []
    },
    {
      "id": "48673800-4477-4de8-9f72-e9b7a9bd9ca0",
      "name": "Authenticate",
      "description": {
        "content": "Authenticate user with MNO or OTP. These endpoints can be directly called by the users.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "c7a3b808-9923-417e-a1af-98d5e8c161cb",
          "name": "This phase is where the Customer requests authorization to perform an authentication for a given device.",
          "request": {
            "name": "This phase is where the Customer requests authorization to perform an authentication for a given device.",
            "description": {
              "content": "This phase is where the Customer requests authorization to perform an authentication for a given device.\n\nThe Customer requests permission to make an Authentication query and receives a timebound token for that transaction. The Customer also must request which authentication technology is required for this transaction.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "oauth",
                "token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{basicAuthUsername}}"
                },
                {
                  "key": "password",
                  "value": "{{basicAuthPassword}}"
                }
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "disabled": false,
                  "key": "scope",
                  "value": "<string>",
                  "description": "(Required) Scope must contain the requested services. It can be authenticate and/or otp concatenated with a “+”."
                },
                {
                  "disabled": false,
                  "key": "grant_type",
                  "value": "<string>",
                  "description": "(Required) The value must be “client_credentials”.By passing this value the service will return an access_token for direct access to the services."
                }
              ]
            }
          },
          "response": [
            {
              "id": "189fcdab-64b1-48a1-941a-8feb147fa540",
              "originalRequest": {
